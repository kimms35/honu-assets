{
 "voice": "ko-KR-Chirp3-HD-Despina",
 "tempo": 1.1,
 "lines": [
  {
   "start": 0,
   "end": 3.2,
   "text": "ChatGPT 대화, 숫자 네 자리로 숨길 수 있어요."
  },
  {
   "start": 3.2,
   "end": 5.8,
   "text": "화면 공유하다 대화 목록이 다 보인 적 있죠?"
  },
  {
   "start": 5.8,
   "end": 8.4,
   "text": "시월 이십일에 잠금 채팅이 생겼어요."
  },
  {
   "start": 8.4,
   "end": 11.0,
   "text": "점 세 개 메뉴에서 Lock chat을 두 번 눌러요."
  },
  {
   "start": 11.0,
   "end": 13.6,
   "text": "처음엔 핀 번호 네 자리를 만들어요."
  },
  {
   "start": 13.6,
   "end": 16.2,
   "text": "그러면 목록, 고정, 검색에서 다 빠져요."
  },
  {
   "start": 16.2,
   "end": 18.8,
   "text": "다시 볼 땐 프로젝트 메뉴 안에서 열어요."
  },
  {
   "start": 18.8,
   "end": 21.4,
   "text": "폰에서는 얼굴 인식이나 지문도 돼요."
  },
  {
   "start": 21.4,
   "end": 24.0,
   "text": "앱을 벗어나면 일 분 뒤에 다시 잠겨요."
  },
  {
   "start": 24.0,
   "end": 26.6,
   "text": "다만 암호화되는 건 아니에요."
  },
  {
   "start": 26.6,
   "end": 29.2,
   "text": "잠그기 전에 기억된 내용도 그대로예요."
  },
  {
   "start": 29.2,
   "end": 32.0,
   "text": "핀을 재설정하면 잠근 대화가 전부 지워져요."
  },
  {
   "start": 32.0,
   "end": 34.6,
   "text": "고객센터도 대신 열어 주지 못해요."
  },
  {
   "start": 34.6,
   "end": 37.2,
   "text": "임시 채팅, 그룹 채팅은 잠글 수 없어요."
  },
  {
   "start": 37.2,
   "end": 39.8,
   "text": "잠근 상태로는 공유나 고정이 안 돼요."
  },
  {
   "start": 39.8,
   "end": 42.4,
   "text": "프로젝트 대화는 잠그면 밖으로 빠져요."
  },
  {
   "start": 42.4,
   "end": 45.0,
   "text": "기록이 안 남는 임시 채팅과는 달라요."
  },
  {
   "start": 45.0,
   "end": 47.6,
   "text": "무료 요금제에서도 쓸 수 있어요."
  },
  {
   "start": 47.6,
   "end": 50.4,
   "text": "잠그는 법, 여는 곳, 주의할 점 두 가지예요."
  },
  {
   "start": 50.4,
   "end": 53.0,
   "text": "저장해 두고 화면 공유 전에 잠가 보세요."
  }
 ]
}