{
 "voice": "ko-KR-Chirp3-HD-Despina",
 "tempo": 1.1,
 "lines": [
  {
   "start": 0,
   "end": 3.2,
   "text": "유료 앱은 계약에 서명 안 하면 제출부터 막혀요."
  },
  {
   "start": 3.2,
   "end": 5.9,
   "text": "무료 앱은 개발자 가입만으로 올릴 수 있어요."
  },
  {
   "start": 5.9,
   "end": 8.6,
   "text": "돈을 받으려면 유료 앱 계약이 따로 필요해요."
  },
  {
   "start": 8.6,
   "end": 11.3,
   "text": "순서는 계약, 세금, 은행 세 단계예요."
  },
  {
   "start": 11.3,
   "end": 14.0,
   "text": "서명은 계정 소유자만 할 수 있어요."
  },
  {
   "start": 14.0,
   "end": 16.7,
   "text": "비즈니스 메뉴, 어그리먼츠 탭에서 해요."
  },
  {
   "start": 16.7,
   "end": 19.4,
   "text": "한번 동의하면 되돌릴 수 없어요."
  },
  {
   "start": 19.4,
   "end": 22.1,
   "text": "서명해도 정보를 다 내기 전엔 대기 상태예요."
  },
  {
   "start": 22.1,
   "end": 24.8,
   "text": "세금은 누구나 미국 양식을 내야 해요."
  },
  {
   "start": 24.8,
   "end": 27.5,
   "text": "미국 밖이면 답변에 따라 양식이 정해져요."
  },
  {
   "start": 27.5,
   "end": 30.2,
   "text": "제출한 뒤엔 직접 못 고치니 잘 확인하세요."
  },
  {
   "start": 30.2,
   "end": 32.9,
   "text": "은행 정보는 세금 양식을 내야 처리돼요."
  },
  {
   "start": 32.9,
   "end": 35.6,
   "text": "예금주는 통장에 적힌 그대로 넣으세요."
  },
  {
   "start": 35.6,
   "end": 38.3,
   "text": "상태가 액티브로 바뀌면 준비 끝이에요."
  },
  {
   "start": 38.3,
   "end": 41.0,
   "text": "정산은 그달이 끝나고 사십오 일 안에 와요."
  },
  {
   "start": 41.0,
   "end": 43.7,
   "text": "최소 지급액을 넘겨야 보내 줘요."
  },
  {
   "start": 43.7,
   "end": 46.4,
   "text": "받는 계좌는 한 곳만 돼요."
  },
  {
   "start": 46.4,
   "end": 50.0,
   "text": "계약, 세금, 은행. 저장해 두고 출시 전에 보세요."
  }
 ]
}